{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m scripts.run_pipeline:*)",
      "Bash(python -m scripts.generate_fixtures:*)",
      "Bash(python -m scripts.evaluate:*)",
      "Bash(python draw_graph.py:*)",
      "Bash(pip list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/.venv/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/.next/**)",
      "Read(./**/__pycache__/**)",
      "Read(./data/uploads/**)",
      "Bash(cat **/.env:*)",
      "Bash(type **/.env:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(del /s:*)"
    ]
  }
}
