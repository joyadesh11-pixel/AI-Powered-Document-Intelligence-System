# Required
GOOGLE_API_KEY=

# Database (postgres 16 + pgvector)
DATABASE_URL=postgresql+psycopg2://dociq:dociq@localhost:5432/dociq

# Test database (separate DB; used by pytest tests/services/)
DATABASE_URL_TEST=postgresql+psycopg2://dociq:dociq@localhost:5432/dociq_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional overrides (defaults shown)
# LLM_MODEL_TEXT=gemini-2.5-flash
# LLM_MODEL_VISION=gemini-2.5-pro
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
# MAX_FILE_MB=25
# TESSERACT_CMD=tesseract
# API_KEY=               # if set, all routes require X-Api-Key header
